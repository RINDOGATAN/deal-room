      "label": { "es": "Domicilio social" },
      "hint": { "es": "Dirección completa del domicilio social" },
      "placeholder": { "es": "p. ej. Calle Gran Vía 1, 28013 Madrid" }
    },
    {
      "id": "meeting-date",
      "token": "FECHA JUNTA",
