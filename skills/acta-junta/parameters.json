      "type": "text",
      "required": true,
      "label": { "es": "Denominación social" },
      "hint": { "es": "Razón social completa de la empresa" },
      "placeholder": { "es": "p. ej. Acme Technologies, S.L." }
    },
    {
      "id": "cif",
      "token": "CIF",
      "type": "text",
      "required": true,
      "label": { "es": "CIF" },
      "hint": { "es": "Código de identificación fiscal de la sociedad" },
      "placeholder": { "es": "p. ej. B12345678" }
    },
    {
      "id": "registered-address",
      "token": "DOMICILIO SOCIAL",
